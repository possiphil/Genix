{
  "metadata": [
    {
      "src": [
        {
          "src": ".artifacts/Genix.Runtime",
          "files": ["Genix.Runtime.dll"]
        },
        {
          "src": ".artifacts/Genix.Editor.Common",
          "files": ["Genix.Editor.Common.dll"]
        },
        {
          "src": ".artifacts/Genix.SpaceFoundation.Editor",
          "files": ["Genix.SpaceFoundation.Editor.dll"]
        },
        {
          "src": ".artifacts/Genix.Editor",
          "files": ["Genix.Editor.dll"]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "toc.yml"
        ],
        "exclude": [
          "_site/**",
          "api/**"
        ]
      },
      {
        "files": [
          "api/**.yml"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "Genix",
      "_appTitle": "Genix Documentation",
      "_enableSearch": true
    }
  }
}
