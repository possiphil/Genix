{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/config-schema.json",
  "stryker-config": {
    "project": "Genix.Mutation.Core.csproj",
    "test-projects": [
      "Genix.Mutation.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "mutate": [
      "../Runtime/Core/GenerationRandom.cs",
      "../Runtime/Extensions/EnumDisplayNameExtensions.cs"
    ],
    "concurrency": 4,
    "break-on-initial-test-failure": true
  }
}
